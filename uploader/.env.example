# YouTube (OAuth desktop client JSON from Google Cloud Console)
YOUTUBE_CLIENT_SECRET_FILE=./client_secret.json

# Meta (Instagram + Threads)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
IG_ACCOUNT_ID=

# Threads uses its own token and user id (graph.threads.net)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Instagram and Threads need a public video URL. Cloudinary hosts it temporarily.
# CLOUDINARY_CLOUD_NAME is required; the old project never set it, so Instagram was skipped.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Notion Research Paper Vault (Personal Access Token "Track papers"). Page id and headings: lib/notion-vault.json
NOTION_TOKEN=
